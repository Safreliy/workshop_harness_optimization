# OpenAI-compatible model endpoint
API_KEY=replace-me
BASE_URL=http://localhost:4000/v1
MODEL_NAME=replace-me
# Optional private CA. By default postgrespro-ca.pem beside .env is loaded if present.
MODEL_CA_FILE=
# Only for a legacy private CA rejected by OpenSSL strict-profile checks.
# Certificate trust and hostname verification remain enabled.
MODEL_CA_ALLOW_LEGACY=0
# Optional explicit route for all hosted model requests, including OpenRouter/Jev.
# Supports HTTP(S) and authenticated SOCKS5; URL-encode special characters in credentials.
# Example placeholder: socks5://user:password@proxy.example:1080
MODEL_PROXY_URL=

# Optional independent audit of free-chat turns (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_AUDITOR_MODEL=openai/gpt-5.4
OPENROUTER_JEV_MODEL=typesafe/jev-1.13

# Local benchmark database (matches docker-compose.yml)
PG_DSN=postgresql://workshop:workshop@localhost:55432/workshop
POSTGRES_PORT=55432
